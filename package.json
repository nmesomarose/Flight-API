    "@types/node": "^22.20.3",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
