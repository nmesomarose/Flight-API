# Flight Booking REST API — environment reference
# Copy to `.env` locally and fill in real values. Never commit `.env`.
# The Prisma CLI reads `.env` automatically; the app reads it via Node's
# built-in env-file loader.

# PostgreSQL connection string (required).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/flight_booking_api

# TCP port the API listens on (optional, default 3000).
PORT=3000

# Rate limiting configuration (target ~100 requests per minute).
# Applied by IP address or globally — never per API key or authenticated
# client (see .agents/rules/rate-limiting.md).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100